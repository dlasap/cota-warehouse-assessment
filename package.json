{
  "name": "cota-warehouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CoTa warehouse assessment: inventory search, open-shelf replenishment and pick lists.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/dev.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/dev.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
